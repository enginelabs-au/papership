{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build -w @papership/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/pitch",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
